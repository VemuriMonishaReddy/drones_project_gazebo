<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="professor_demo">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics>
    <scene><ambient>0.80 0.80 0.80 1</ambient><background>0.72 0.84 0.96 1</background><shadows>true</shadows><grid>false</grid></scene>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <light name="sun" type="directional"><pose>0 0 12 0.35 -0.45 0.2</pose><direction>-0.25 0.35 -1</direction><diffuse>1 1 1 1</diffuse><specular>0.8 0.8 0.8 1</specular><attenuation><range>100</range></attenuation><cast_shadows>true</cast_shadows></light>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>

    <gui fullscreen="0">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui><title>Professor Drone Demonstration</title><property type="bool" key="showTitleBar">false</property><property type="string" key="state">docked</property></gz-gui>
        <engine>ogre2</engine><scene>scene</scene>
        <ambient_light>0.85 0.85 0.85 1</ambient_light>
        <background_color>0.72 0.84 0.96 1</background_color>
        <camera_pose>-12.5 -13.5 8.5 0 0.47 0.77</camera_pose>
        <camera_clip><near>0.1</near><far>200</far></camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="state" type="string">docked</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
    </gui>

    <model name="ground"><static>true</static><link name="link"><collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry></collision><visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 30</size></plane></geometry><material><ambient>0.42 0.45 0.48 1</ambient><diffuse>0.58 0.62 0.66 1</diffuse></material></visual></link></model>

    <!-- Mixed obstacle types: boxes, cylinders, a wall and a gate -->
    <model name="box_obstacle"><static>true</static><pose>0 -4.0 2.0 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.8 2.2 4.0</size></box></geometry></collision><visual name="v"><geometry><box><size>1.8 2.2 4.0</size></box></geometry><material><ambient>0.65 0.12 0.12 1</ambient><diffuse>0.85 0.18 0.18 1</diffuse></material></visual></link></model>
    <model name="cylinder_obstacle"><static>true</static><pose>4 1.2 1.8 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>1.0</radius><length>3.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>1.0</radius><length>3.6</length></cylinder></geometry><material><ambient>0.65 0.30 0.05 1</ambient><diffuse>0.95 0.50 0.05 1</diffuse></material></visual></link></model>
    <model name="wall_obstacle"><static>true</static><pose>-3.2 2.7 2.5 0 0 0.15</pose><link name="link"><collision name="c"><geometry><box><size>4.8 0.8 5.0</size></box></geometry></collision><visual name="v"><geometry><box><size>4.8 0.8 5.0</size></box></geometry><material><ambient>0.08 0.35 0.65 1</ambient><diffuse>0.08 0.50 0.90 1</diffuse></material></visual></link></model>
    <model name="gate_left"><static>true</static><pose>8.0 -7.0 2.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.7 0.8 5.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 0.8 5.6</size></box></geometry><material><ambient>0.25 0.60 0.18 1</ambient><diffuse>0.35 0.85 0.22 1</diffuse></material></visual></link></model>
    <model name="gate_right"><static>true</static><pose>8.0 -9.0 2.8 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.7 0.8 5.6</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 0.8 5.6</size></box></geometry><material><ambient>0.25 0.60 0.18 1</ambient><diffuse>0.35 0.85 0.22 1</diffuse></material></visual></link></model>
    <model name="overhead_bar"><static>true</static><pose>-5.0 5.0 5.2 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>3.5 0.8 0.6</size></box></geometry></collision><visual name="v"><geometry><box><size>3.5 0.8 0.6</size></box></geometry><material><ambient>0.55 0.05 0.55 1</ambient><diffuse>0.75 0.10 0.75 1</diffuse></material></visual></link></model>

    <!-- Bright safe-corridor guides: visual-only, no collision geometry. -->
    <model name="safe_corridor_guides" static="true">
      <link name="link">
        <visual name="approach"><pose>-4.6 -4.0 0.035 0 0 0</pose><geometry><box><size>2.8 0.9 0.04</size></box></geometry><material><ambient>0.10 0.75 0.20 1</ambient><diffuse>0.15 0.95 0.25 1</diffuse><emissive>0.02 0.25 0.03 1</emissive></material></visual>
        <visual name="detour"><pose>0.0 -6.8 0.035 0 0 0</pose><geometry><box><size>6.4 0.9 0.04</size></box></geometry><material><ambient>0.10 0.75 0.20 1</ambient><diffuse>0.15 0.95 0.25 1</diffuse><emissive>0.02 0.25 0.03 1</emissive></material></visual>
        <visual name="return"><pose>4.5 -5.4 0.035 0 0 0</pose><geometry><box><size>0.9 2.8 0.04</size></box></geometry><material><ambient>0.10 0.75 0.20 1</ambient><diffuse>0.15 0.95 0.25 1</diffuse><emissive>0.02 0.25 0.03 1</emissive></material></visual>
      </link>
    </model>

    <!-- Bright visual wind field: arrows make the disturbance direction obvious during the demo. -->
    <model name="wind_visual" static="true">
      <pose>3.0 -1.0 3.6 0 0 0</pose>
      <link name="link">
        <visual name="shaft1"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><radius>0.035</radius><length>2.2</length></cylinder></geometry><material><ambient>0.05 0.55 0.95 1</ambient><diffuse>0.05 0.75 1.0 1</diffuse><emissive>0.02 0.25 0.45 1</emissive></material></visual>
        <visual name="head1"><pose>1.25 0 0 0 1.5708 0</pose><geometry><cone><radius>0.18</radius><length>0.42</length></cone></geometry><material><ambient>0.05 0.55 0.95 1</ambient><diffuse>0.05 0.75 1.0 1</diffuse><emissive>0.02 0.25 0.45 1</emissive></material></visual>
        <visual name="shaft2"><pose>0 0.55 0.0 0 1.5708 0</pose><geometry><cylinder><radius>0.035</radius><length>2.2</length></cylinder></geometry><material><ambient>0.05 0.55 0.95 1</ambient><diffuse>0.05 0.75 1.0 1</diffuse><emissive>0.02 0.25 0.45 1</emissive></material></visual>
        <visual name="head2"><pose>1.25 0.55 0 0 1.5708 0</pose><geometry><cone><radius>0.18</radius><length>0.42</length></cone></geometry><material><ambient>0.05 0.55 0.95 1</ambient><diffuse>0.05 0.75 1.0 1</diffuse><emissive>0.02 0.25 0.45 1</emissive></material></visual>
        <visual name="shaft3"><pose>0 -0.55 0.0 0 1.5708 0</pose><geometry><cylinder><radius>0.035</radius><length>2.2</length></cylinder></geometry><material><ambient>0.05 0.55 0.95 1</ambient><diffuse>0.05 0.75 1.0 1</diffuse><emissive>0.02 0.25 0.45 1</emissive></material></visual>
        <visual name="head3"><pose>1.25 -0.55 0 0 1.5708 0</pose><geometry><cone><radius>0.18</radius><length>0.42</length></cone></geometry><material><ambient>0.05 0.55 0.95 1</ambient><diffuse>0.05 0.75 1.0 1</diffuse><emissive>0.02 0.25 0.45 1</emissive></material></visual>
      </link>
    </model>

    <!-- ===================== REALISTIC WEATHER / ENVIRONMENT ===================== -->
    <!-- Trees provide visual scale and make the outdoor wind scene immediately readable. -->
    <model name="tree_1"><static>true</static><pose>-8 5 0 0 0 0</pose><link name="link">
      <visual name="trunk"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>4</length></cylinder></geometry><material><ambient>0.25 0.12 0.05 1</ambient><diffuse>0.38 0.20 0.08 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 4.5 0 0 0</pose><geometry><sphere><radius>1.5</radius></sphere></geometry><material><ambient>0.08 0.28 0.06 1</ambient><diffuse>0.14 0.48 0.10 1</diffuse></material></visual>
    </link></model>
    <model name="tree_2"><static>true</static><pose>-8 -1 0 0 0 0</pose><link name="link">
      <visual name="trunk"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>4</length></cylinder></geometry><material><ambient>0.25 0.12 0.05 1</ambient><diffuse>0.38 0.20 0.08 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 4.4 0 0 0</pose><geometry><sphere><radius>1.35</radius></sphere></geometry><material><ambient>0.08 0.28 0.06 1</ambient><diffuse>0.14 0.48 0.10 1</diffuse></material></visual>
    </link></model>
    <model name="tree_3"><static>true</static><pose>8 5 0 0 0 0</pose><link name="link">
      <visual name="trunk"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>4</length></cylinder></geometry><material><ambient>0.25 0.12 0.05 1</ambient><diffuse>0.38 0.20 0.08 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 4.5 0 0 0</pose><geometry><sphere><radius>1.5</radius></sphere></geometry><material><ambient>0.08 0.28 0.06 1</ambient><diffuse>0.14 0.48 0.10 1</diffuse></material></visual>
    </link></model>
    <model name="tree_4"><static>true</static><pose>8 -1 0 0 0 0</pose><link name="link">
      <visual name="trunk"><pose>0 0 2 0 0 0</pose><geometry><cylinder><radius>0.18</radius><length>4</length></cylinder></geometry><material><ambient>0.25 0.12 0.05 1</ambient><diffuse>0.38 0.20 0.08 1</diffuse></material></visual>
      <visual name="crown"><pose>0 0 4.4 0 0 0</pose><geometry><sphere><radius>1.35</radius></sphere></geometry><material><ambient>0.08 0.28 0.06 1</ambient><diffuse>0.14 0.48 0.10 1</diffuse></material></visual>
    </link></model>

    <!-- Wind-borne leaves: horizontal particles make the gust visible rather than relying on arrows alone. -->
    <model name="wind_leaves"><static>true</static><pose>-8 -1 6.0 0 0 0</pose><link name="link">
      <particle_emitter name="leaves" type="box">
        <emitting>true</emitting><size>16 12 0</size><particle_size>0.12 0.035 0.01</particle_size>
        <lifetime>5</lifetime><min_velocity>2.2</min_velocity><max_velocity>4.0</max_velocity><rate>14</rate>
        <particle_scatter_ratio>0.0</particle_scatter_ratio>
        <material><diffuse>0.16 0.55 0.08 1</diffuse><ambient>0.08 0.30 0.04 1</ambient></material>
      </particle_emitter>
    </link></model>

    <!-- Lightweight paper scraps: white particles moving with the same wind make the gust easy to see. -->
    <model name="wind_papers"><static>true</static><pose>-8 -1 4.8 0 0 0</pose><link name="link">
      <particle_emitter name="papers" type="box">
        <emitting>true</emitting><size>16 12 0</size><particle_size>0.18 0.12 0.01</particle_size>
        <lifetime>4</lifetime><min_velocity>2.8</min_velocity><max_velocity>5.0</max_velocity><rate>7</rate>
        <particle_scatter_ratio>0.0</particle_scatter_ratio>
        <material><diffuse>0.92 0.92 0.86 1</diffuse><ambient>0.65 0.65 0.60 1</ambient></material>
      </particle_emitter>
    </link></model>

    <!-- Rain: vertical blue-white particles, activated for the storm phase. -->
    <model name="rain_field"><static>true</static><pose>-1 0 11 0 1.5708 0</pose><link name="link">
      <particle_emitter name="rain" type="box">
        <emitting>false</emitting><size>18 14 0</size><particle_size>0.018 0.24 0.01</particle_size>
        <lifetime>2.2</lifetime><min_velocity>10</min_velocity><max_velocity>16</max_velocity><rate>110</rate>
        <particle_scatter_ratio>0.0</particle_scatter_ratio>
        <material><diffuse>0.68 0.86 1.0 0.75</diffuse><ambient>0.40 0.60 0.90 1</ambient></material>
      </particle_emitter>
    </link></model>

    <!-- Bright storm marker so the professor can see exactly when the rain experiment starts. -->
    <model name="weather_sign"><static>true</static><pose>5.8 5.2 2.1 0 0 0</pose><link name="link">
      <visual name="post"><pose>0 0 1.1 0 0 0</pose><geometry><cylinder><radius>0.06</radius><length>2.2</length></cylinder></geometry><material><diffuse>0.20 0.20 0.22 1</diffuse></material></visual>
      <visual name="board"><pose>0 0 2.25 0 0 0</pose><geometry><box><size>1.7 0.12 0.75</size></box></geometry><material><ambient>0.05 0.25 0.65 1</ambient><diffuse>0.08 0.45 0.95 1</diffuse><emissive>0.01 0.10 0.25 1</emissive></material></visual>
    </link></model>

    <model name="wind_visual_field" static="true">
      <pose>-2.0 1.0 4.2 0 0 0</pose><link name="link">
        <visual name="a"><pose>0 0 0 0 1.5708 0</pose><geometry><cylinder><radius>0.045</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.02 0.65 1.0 1</diffuse><emissive>0.02 0.35 0.75 1</emissive></material></visual>
        <visual name="b"><pose>1.65 0 0 0 1.5708 0</pose><geometry><cone><radius>0.22</radius><length>0.48</length></cone></geometry><material><diffuse>0.02 0.75 1.0 1</diffuse><emissive>0.02 0.35 0.75 1</emissive></material></visual>
        <visual name="c"><pose>0 0.75 0 0 1.5708 0</pose><geometry><cylinder><radius>0.045</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.02 0.65 1.0 1</diffuse><emissive>0.02 0.35 0.75 1</emissive></material></visual>
        <visual name="d"><pose>1.65 0.75 0 0 1.5708 0</pose><geometry><cone><radius>0.22</radius><length>0.48</length></cone></geometry><material><diffuse>0.02 0.75 1.0 1</diffuse><emissive>0.02 0.35 0.75 1</emissive></material></visual>
        <visual name="e"><pose>0 -0.75 0 0 1.5708 0</pose><geometry><cylinder><radius>0.045</radius><length>3.0</length></cylinder></geometry><material><diffuse>0.02 0.65 1.0 1</diffuse><emissive>0.02 0.35 0.75 1</emissive></material></visual>
        <visual name="f"><pose>1.65 -0.75 0 0 1.5708 0</pose><geometry><cone><radius>0.22</radius><length>0.48</length></cone></geometry><material><diffuse>0.02 0.75 1.0 1</diffuse><emissive>0.02 0.35 0.75 1</emissive></material></visual>
      </link>
    </model>

    <model name="alpha"><static>false</static><pose>-6.0 -4.0 3.6 0 0 0</pose>
      <link name="base_link"><inertial><mass>1.35</mass><inertia><ixx>0.025</ixx><iyy>0.025</iyy><izz>0.045</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="body_collision"><geometry><box><size>0.55 0.38 0.18</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>0.62 0.42 0.18</size></box></geometry><material><ambient>0.08 0.08 0.10 1</ambient><diffuse>0.85 0.55 0.05 1</diffuse><specular>0.8 0.8 0.8 1</specular></material></visual>
        <visual name="top_plate"><pose>0 0 0.13 0 0 0</pose><geometry><box><size>0.52 0.34 0.06</size></box></geometry><material><ambient>0.65 0.65 0.68 1</ambient><diffuse>0.95 0.78 0.18 1</diffuse></material></visual>
        <visual name="front_led"><pose>0.32 0 0 0 0 0</pose><geometry><box><size>0.05 0.20 0.08</size></box></geometry><material><ambient>0.05 0.65 0.95 1</ambient><diffuse>0.10 0.90 1.0 1</diffuse><emissive>0.1 0.7 1.0 1</emissive></material></visual>
        <visual name="arm_fl"><pose>0.17 0.17 0 0 0 0.785</pose><geometry><box><size>0.78 0.09 0.09</size></box></geometry><material><ambient>0.75 0.55 0.05 1</ambient><diffuse>0.95 0.70 0.08 1</diffuse></material></visual><visual name="arm_fr"><pose>0.17 -0.17 0 0 0 -0.785</pose><geometry><box><size>0.78 0.09 0.09</size></box></geometry><material><ambient>0.22 0.23 0.26 1</ambient><diffuse>0.30 0.32 0.36 1</diffuse></material></visual><visual name="arm_rl"><pose>-0.17 0.17 0 0 0 -0.785</pose><geometry><box><size>0.78 0.09 0.09</size></box></geometry><material><ambient>0.22 0.23 0.26 1</ambient><diffuse>0.30 0.32 0.36 1</diffuse></material></visual><visual name="arm_rr"><pose>-0.17 -0.17 0 0 0 0.785</pose><geometry><box><size>0.78 0.09 0.09</size></box></geometry><material><ambient>0.22 0.23 0.26 1</ambient><diffuse>0.30 0.32 0.36 1</diffuse></material></visual>
              <sensor name="imu" type="imu"><always_on>true</always_on><update_rate>100</update_rate><topic>imu</topic></sensor>
        <sensor name="lidar" type="gpu_lidar"><pose>0.36 0 0.10 0 0 0</pose><topic>/model/alpha/lidar</topic><update_rate>20</update_rate><always_on>true</always_on><visualize>true</visualize><lidar><scan><horizontal><samples>181</samples><resolution>1</resolution><min_angle>-1.5708</min_angle><max_angle>1.5708</max_angle></horizontal></scan><range><min>0.20</min><max>10.0</max><resolution>0.02</resolution></range></lidar></sensor>
      </link>
      <link name="rotor_0"><pose>0.48 0.48 0.05 0 0 0</pose><inertial><mass>0.04</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="motor"><geometry><cylinder><radius>0.11</radius><length>0.14</length></cylinder></geometry><material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual><visual name="prop_a"><pose>0 0 0.08 0 0 0.25</pose><geometry><box><size>0.55 0.035 0.012</size></box></geometry><material><ambient>0.65 0.65 0.68 0.9</ambient><diffuse>0.75 0.75 0.78 0.9</diffuse></material></visual><visual name="prop_b"><pose>0 0 0.08 0 0 1.82</pose><geometry><box><size>0.55 0.035 0.012</size></box></geometry><material><ambient>0.65 0.65 0.68 0.9</ambient><diffuse>0.75 0.75 0.78 0.9</diffuse></material></visual></link><joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint><link name="rotor_1"><pose>0.48 -0.48 0.05 0 0 0</pose><inertial><mass>0.04</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial><visual name="motor"><geometry><cylinder><radius>0.11</radius><length>0.14</length></cylinder></geometry><material><ambient>0.05 0.05 0.06 1</ambient><diffuse>0.12 0.12 0.14 1</diffuse></material></visual><visual name="prop_a"><pose>0 0 0.08 0 0 0.25</pose><geometry><box><size>0.55 0.035 0.012</size></box></geometry><material><ambient>0.65 0.65 0.68 0.9</ambient><diffuse>0.75 0.75 0.78 0.9</diffuse></material></visual><visual name="prop_b"><pose>0 0 0.08 0 0 1.82</pose><geometry><box><size>0.55 0.035 0.012</size></box></geometry><material><ambient>0.65 0.65 0.68 0.9</ambient><diffuse>0.75 0.75 0.78 0.9</diffuse></material></visual></link><joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz><l